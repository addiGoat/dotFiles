* {
    font: "JetBrainsMono Nerd Font 14";
    bg: #14100e;
    fg: #cdd6f8;
    hi-bg: #708ec9;
    hi-fg: #d8d0c8;
    bg-blue: #1d1f23;

    border: 0px;
    border-radius: 0px;
    margin: 0px;
}

window {
    width: 25%;
    y-offset: 25%;

    location: north;
    anchor: north;

    padding: 0px;
    border: 0px;

    background-color: @bg-blue;
}

mainbox {
    orientation: horizontal;
    children: [ "leftbox", "rightbox" ];
    spacing: 0px;
    padding: 0px;
    background-color: @bg-blue;
}

leftbox {
    orientation: vertical;
    children: [ "prompt", "leftblank" ];
    expand: false;
}

rightbox {
    orientation: vertical;
    children: [ "entry", "listview" ];
}

entry {
    padding: 4px 4px;
    margin: 0px;
    background-color: @bg-blue;
    text-color: @fg;
}

listview {
    lines: 6;
    fixed-height: false;

    padding: 0px;
    
    border: 0px;

    scrollbar: false;
    expand: false;

}

// "run:", "cmd:" etc.
prompt {
    padding: 4px;
    background-color: @hi-bg;
    text-color: @hi-fg;
}

message {
    padding: 0px;
    margin: 0px;
    border: 0px;
    spacing: 0px;
}


element {
    padding: 4px 4px;
}

element-text {
    text-color: @fg;
}

element-text selected,
element selected.normal {
    background-color: @hi-bg;
}

element normal.normal, 
element alternate.normal {
    background-color: @bg-blue;
}


