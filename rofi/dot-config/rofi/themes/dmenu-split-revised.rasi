* {
    font: "JetBrainsMono Nerd Font 14";

    /* One terminal-like field, with an accent prompt and a light selection. */
    bg: #14100e;
    fg: #cdd6f8;
    accent-bg: #7999d9;
    accent-fg: #14100e;
    selected-bg: #d8d0c8;
    selected-fg: #14100e;

    border: 0px;
    border-radius: 0px;
    margin: 0px;
}

window {
    width: 665px;
    location: north;
    anchor: north;
    y-offset: 400px;

    padding: 0px;
    margin: 0px;
    border: 0px;
    border-radius: 0px;
    background-color: @bg;
}

mainbox {
    orientation: vertical;
    children: [ "inputbar", "listview" ];
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    border: 0px;
    background-color: @bg;
}

inputbar {
    children: [ "prompt", "entry" ];
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    border: 0px;
    background-color: @bg;
}

prompt {
    padding: 4px 8px;
    margin: 0px;
    border: 0px;
    border-radius: 0px;
    background-color: @accent-bg;
    text-color: @accent-fg;
}

entry {
    margin: 0px;
    padding: 4px 8px;
    border: 0px;
    border-radius: 0px;
    background-color: @bg;
    text-color: @fg;
}

listview {
    lines: 6;
    fixed-height: false;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    border: 0px;
    background-color: @bg;
}

element {
    margin: 0px;
    border: 0px;
    border-radius: 0px;
    padding: 2px 8px;
    background-color: @bg;
    text-color: @fg;
}

element selected {
    margin: 0px;
    border: 0px;
    border-radius: 0px;
    background-color: @selected-bg;
    text-color: @selected-fg;
}

/* State-specific values avoid depending on Rofi's inheritance resolution. */
element-text {
    background-color: @bg;
    text-color: @fg;
}

element-text selected {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

scrollbar {
    enabled: false;
}
